# AMaps Plugin Configuration
# Copy this file to .env in your vault root and fill in your values
# DO NOT commit .env to git - it contains sensitive information

# AMap (Gaode Maps) API Key
# Get one at: https://lbs.amap.com/dev/key
AMAP_API_KEY=your_api_key_here

# AMap Security Config (安全密钥)
# Required for API keys created after Dec 2, 2021
AMAP_SECURITY_JS_CODE=your_security_code_here
